version_info: "0"
resources {
  [type.googleapis.com/envoy.config.cluster.v3.Cluster] {
    name: "cluster_0"
    type: STATIC
    load_assignment {
      cluster_name: "cluster_1"
      endpoints {
        lb_endpoints {
          endpoint {
            address {
              socket_address {
                address: "::1"
                port_value: 443
	      }
	    }
	  }
	}
      }
    }
    connect_timeout {
      nanos: 100000000
    }
  }
}
type_url: "type.googleapis.com/envoy.config.cluster.v3.Cluster"
